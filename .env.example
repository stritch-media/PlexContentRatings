# Copy to .env and fill in. .env is gitignored.

# Plex — one token per server.
# Get it: Plex Web → any item → ⋯ → Get Info → View XML → X-Plex-Token in the URL
# Direct URLs are fastest (LAN IP / hostname + port). Leave a URL blank to
# discover that server via plex.tv using its NAME + TOKEN instead.
PLEX_SERVER_1_NAME=Appbox
PLEX_SERVER_1_URL=
PLEX_SERVER_1_TOKEN=

PLEX_SERVER_2_NAME=Kyle's Plex Server
PLEX_SERVER_2_URL=
PLEX_SERVER_2_TOKEN=

# Libraries to scan on each server (comma-separated, exact names)
PLEX_LIBRARIES=4K Movies,Movies,4K TV Shows,TV Shows
PLEX_COLLECTION=*NEEDS PROPER RATING*

# Rating sources
# TMDB: https://www.themoviedb.org/settings/api  (free; v3 API key)
TMDB_API_KEY=
# OMDb: https://www.omdbapi.com/apikey.aspx  (free tier, 1000 req/day)
OMDB_API_KEY=
